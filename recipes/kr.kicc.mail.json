{
  "id": "kr.kicc.mail",
  "name": "KICC 이지페이 결제 메일",
  "version": 1,
  "channels": [
    "mail"
  ],
  "match": {
    "from": "easypay|KICC",
    "any": [
      "결제내역|취소내역"
    ]
  },
  "kind": "item",
  "extract": [
    "(?:결제|취소)일시\\s*\\|?\\s*\\n?\\s*(?<year>\\d{4})/(?<month>\\d{1,2})/(?<day>\\d{1,2})\\s+(?<hour>\\d{1,2}):(?<minute>\\d{2})",
    "(?:상품|결제|취소)금액\\s*\\|?\\s*\\n?\\s*(?<amount>[\\d,]*\\d)\\s*원",
    "상호\\s*\\|?\\s*\\n?\\s*(?<merchant>[^|\\n]+)",
    "상품명\\s*\\|?\\s*\\n?\\s*(?<item>[^|\\n]+)",
    "결제기관\\s*\\|?\\s*\\n?\\s*(?<issuer>[^|\\n\\s]+)"
  ],
  "set": {
    "card": "{issuer}카드"
  },
  "cancel": "취소내역|취소일시",
  "generic": false,
  "examples": [
    {
      "channel": "mail",
      "from": "한국정보통신 KICC<easypay_noreturn@easypay.example.com>",
      "subject": "홍*동님, 샘플스토어에서 [신용카드]결제하신 내역입니다.",
      "text": "이지페이 결제내역\n\n | \n\n 홍*동님, 샘플스토어에서 2026/10/14 12:30에 결제하신 내역입니다. | \n\n 구매자명 | \n 홍*동 님 | \n\n 상품명 | \n 샘플 텀블러 | \n\n 결제일시 | \n 2026/10/14 12:30 | \n\n 결제수단 | \n 신용카드 | \n\n 승인번호 | \n 00000000 | \n\n 결제기관 | \n 샘플 | \n\n 상품금액 | \n 23,000원 | \n\n 할부개월 | \n 0 | \n\n 상점정보 | \n\n 상호 | \n 샘플스토어 | \n\n 연락처 | \n 0000-0000 |",
      "expect": {
        "merchant": "샘플스토어",
        "amount": "₩23,000",
        "card": "샘플카드",
        "item": "샘플 텀블러",
        "time": "2026-10-14T12:30:00+09:00"
      }
    }
  ]
}

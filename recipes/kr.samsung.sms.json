{
  "id": "kr.samsung.sms",
  "name": "삼성카드 문자",
  "version": 1,
  "channels": [
    "sms",
    "notification"
  ],
  "match": {
    "any": [
      "삼성(?:카드\\s*\\d{0,4}|\\d{4})"
    ],
    "all": [
      "승인|취소"
    ]
  },
  "set": {
    "card": "삼성카드"
  },
  "examples": [
    {
      "text": "[Web발신]\n삼성1234승인 홍*동\n1,500원 일시불\n10/15 09:11 샘플편의점\n누적98,765원",
      "expect": {
        "merchant": "샘플편의점",
        "amount": "₩1,500",
        "card": "삼성카드 일시불"
      }
    },
    {
      "text": "[Web발신]\n삼성카드 승인 홍*동\n8,000원 일시불\n10/15 13:02\n샘플분식\n누적 50,000원",
      "expect": {
        "merchant": "샘플분식",
        "amount": "₩8,000",
        "card": "삼성카드 일시불"
      }
    },
    {
      "text": "[Web발신]\n삼성1234취소 홍*동\n8,000원\n10/15 13:40 샘플분식",
      "expect": {
        "merchant": "샘플분식",
        "amount": "-₩8,000",
        "card": "삼성카드 취소"
      }
    }
  ]
}

{
  "id": "kr.kcp.mail",
  "name": "NHN KCP 결제 메일",
  "version": 1,
  "channels": [
    "mail"
  ],
  "match": {
    "subject": "KCP",
    "any": [
      "결제금액|취소금액"
    ]
  },
  "kind": "item",
  "extract": [
    "(?:결제|취소)일시\\s*\\|?\\s*\\n?\\s*(?<year>\\d{4})년\\s*(?<month>\\d{1,2})월\\s*(?<day>\\d{1,2})일\\s*(?<hour>\\d{1,2})시\\s*(?<minute>\\d{1,2})분",
    "(?:결제|취소)금액\\s*\\|?\\s*\\n?\\s*(?<amount>[\\d,]*\\d)\\s*원",
    "구매상점명\\s*\\|?\\s*\\n?\\s*(?<merchant>[^|\\n]+)",
    "주문상품명\\s*\\|?\\s*\\n?\\s*(?<item>[^|\\n]+)",
    "카드종류\\s*\\|?\\s*\\n?\\s*(?<card>[^|\\n]+)",
    "할부기간\\s*\\|?\\s*\\n?\\s*(?<plan>[^|\\n]+)"
  ],
  "cancel": "취소금액|취소일시",
  "generic": false,
  "examples": [
    {
      "channel": "mail",
      "subject": "NHN KCP - 샘플스토어의 결제 안내",
      "text": "NHN KCP 결제 안내\n\n결제일시 | 2026년 10월 14일 12시 30분 |\n구매상점명 | 샘플스토어 |\n주문상품명 | 샘플 텀블러 |\n결제금액 | 23,000원 |\n카드종류 | 샘플카드 |\n할부기간 | 일시불 |\n승인번호 | 00000000 |",
      "expect": {
        "merchant": "샘플스토어",
        "amount": "₩23,000",
        "card": "샘플카드 일시불",
        "item": "샘플 텀블러",
        "time": "2026-10-14T12:30:00+09:00"
      }
    },
    {
      "channel": "mail",
      "subject": "NHN KCP - 샘플스토어의 결제취소 안내",
      "text": "NHN KCP 결제취소 안내\n\n취소일시\n2026년 10월 15일 09시 05분\n구매상점명\n샘플스토어\n주문상품명\n샘플 텀블러\n취소금액\n23,000원\n카드종류\n샘플카드",
      "expect": {
        "merchant": "샘플스토어",
        "amount": "-₩23,000",
        "card": "샘플카드 취소",
        "item": "샘플 텀블러"
      }
    }
  ]
}

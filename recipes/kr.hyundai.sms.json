{
  "id": "kr.hyundai.sms",
  "name": "현대카드 문자",
  "version": 1,
  "channels": [
    "sms",
    "notification"
  ],
  "match": {
    "any": [
      "현대카드",
      "^현대\\s+\\S.*(?:승인|취소)"
    ],
    "all": [
      "승인|취소"
    ]
  },
  "extract": [
    "^(?:현대카드|현대)\\s+(?<product>.+?)\\s*(?:승인|취소|거절)"
  ],
  "set": {
    "card": "현대카드 {product}"
  },
  "examples": [
    {
      "text": "[Web발신]\n현대카드 M 승인\n홍*동\n12,500원 일시불\n10/14 12:30\n샘플카페\n누적 345,000원",
      "expect": {
        "merchant": "샘플카페",
        "amount": "₩12,500",
        "card": "현대카드 M 일시불"
      }
    },
    {
      "text": "[Web발신]\n현대 네이버 승인\n홍*동\n19,900원 일시불\n10/14 20:56\n샘플식당\n누적1,234,560원",
      "expect": {
        "merchant": "샘플식당",
        "amount": "₩19,900",
        "card": "현대카드 네이버 일시불"
      }
    },
    {
      "text": "[Web발신]\n현대카드 ZERO 승인\n홍*동\n360,000원 3개월\n10/02 18:05\n샘플전자\n누적 1,000,000원",
      "expect": {
        "merchant": "샘플전자",
        "amount": "₩360,000",
        "card": "현대카드 ZERO 3개월"
      }
    },
    {
      "text": "[현대카드] 홍*동님 09/15 샘플페이(주) 사용 106,800원 취소처리되었습니다",
      "expect": {
        "merchant": "샘플페이(주)",
        "amount": "-₩106,800",
        "card": "현대카드 취소"
      }
    },
    {
      "text": "[현대카드] 홍*동님 10/13 해외사용 Sample*Shop CNY 48.60 취소처리 되었습니다.",
      "expect": {
        "merchant": "Sample*Shop",
        "amount": "-CNY 48.60",
        "card": "현대카드 취소"
      }
    }
  ]
}

{
  "$comment": "memexhub design tokens: the only place colors, type, spacing, radii and motion are defined. Run `npm run tokens` after a change; it writes the Android and web code. Direction (2026-10-27): clean, big numbers first; the logo ink plus one accent, index blue.",
  "color": {
    "page":       { "light": "#F2F3F5", "dark": "#0E0E10", "use": "screen background behind cards" },
    "surface":    { "light": "#FFFFFF", "dark": "#1B1B1F", "use": "cards, bars" },
    "sunken":     { "light": "#F7F7F8", "dark": "#141417", "use": "inputs, code, pressed rows inside a card" },
    "ink":        { "light": "#18181B", "dark": "#F4F4F5", "use": "text and big numbers (the logo's ink)" },
    "sub":        { "light": "#6B6B74", "dark": "#9D9DA6", "use": "secondary text, labels, meta" },
    "line":       { "light": "#E4E4E7", "dark": "#34343A", "use": "hairlines, unchecked boxes, idle dots" },
    "accent":     { "light": "#3355E0", "dark": "#7F9BFF", "use": "the one brand color: primary button, highlighted figures, selection" },
    "onAccent":   { "light": "#FFFFFF", "dark": "#0B1440", "use": "text on accent" },
    "accentSoft": { "light": "#E9EEFC", "dark": "#1D2547", "use": "soft button, icon tile, progress track" },
    "ok":         { "light": "#1AA260", "dark": "#3CCF85", "use": "status dot: working" },
    "warn":       { "light": "#D98A00", "dark": "#F2B33D", "use": "status dot: look at this" },
    "danger":     { "light": "#E5484D", "dark": "#FF6B70", "use": "errors and destructive actions only" }
  },
  "type": {
    "display":  { "size": 34, "line": 40, "weight": 800, "tracking": -0.03, "use": "the one big number on a card" },
    "title":    { "size": 26, "line": 32, "weight": 800, "tracking": -0.02, "use": "screen title" },
    "headline": { "size": 17, "line": 24, "weight": 700, "tracking": -0.01, "use": "card title, row title" },
    "body":     { "size": 15, "line": 22, "weight": 400, "tracking": 0, "use": "running text, list rows" },
    "label":    { "size": 14, "line": 20, "weight": 500, "tracking": 0, "use": "card label above a number, buttons" },
    "caption":  { "size": 13, "line": 18, "weight": 500, "tracking": 0, "use": "meta, hints, times" }
  },
  "space": { "xxs": 4, "xs": 8, "s": 12, "m": 16, "l": 20, "xl": 24, "xxl": 32 },
  "radius": { "control": 14, "card": 22, "chip": 999 },
  "layout": {
    "gutter": 16,
    "cardPadding": 20,
    "twoPane": 600,
    "listPane": 360,
    "content": 768,
    "$comment": "twoPane: from this width (an unfolded Galaxy Z Fold, tablets) screens use a side rail and two columns"
  },
  "motion": {
    "numberMs": 600,
    "enterMs": 220,
    "pressScale": 0.96,
    "$comment": "numbers count up once when they first appear; respect the system's reduced-motion setting"
  }
}
